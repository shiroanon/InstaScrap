{
  "manifest_version": 3,
  "name": "InstaScrap – Instagram Downloader",
  "short_name": "InstaScrap",
  "version": "2.4.0",
  "description": "Download Instagram reels, photos & carousels. Fix 2.4.0: all Instagram traffic now originates in the service worker against i.instagram.com with verbatim-captured auth headers — mirrors the working Bulk-Saver transport.",
  "permissions": [
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://i.instagram.com/*",
    "*://*.instagram.com/*",
    "*://*.cdninstagram.com/*",
    "*://*.fbcdn.net/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content/extract.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["lib/jszip.min.js", "content/panel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/zip-worker.js", "lib/jszip.min.js"],
      "matches": ["*://*.instagram.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "InstaScrap"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
